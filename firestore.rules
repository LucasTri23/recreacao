rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function member() { return request.auth != null && profile().role in ['admin', 'director']; }
    function admin() { return member() && profile().role == 'admin'; }
    function manages(team) { return admin() || (member() && profile().team == team); }
    function defaultTeams() { return {"BRANCO":{"name":"BRANCO","color":"white","badge":"⚪","status":"active"},"PRETO":{"name":"PRETO","color":"black","badge":"⚫","status":"active"},"BLUES":{"name":"BLUES","color":"blue","badge":"🔵","status":"active"},"COIOTES":{"name":"COIOTES","color":"brown","badge":"C","status":"active"},"VETOR NORTE":{"name":"VETOR NORTE","color":"olive","badge":"↑","status":"active"},"AMARELO":{"name":"AMARELO","color":"yellow","badge":"🟡","status":"active"},"LARANJA":{"name":"LARANJA","color":"orange","badge":"🟠","status":"active"},"VERDE":{"name":"VERDE","color":"green","badge":"🟢","status":"active"}}; }
    function teamCatalog() { return exists(/databases/$(database)/documents/settings/teams) ? get(/databases/$(database)/documents/settings/teams).data.items : defaultTeams(); }
    function teamActive(id) { let items = teamCatalog(); return id in items && items[id].status == 'active'; }
    function active(p) { return !('mergedInto' in p) && p.get('status','active') == 'active'; }
    function playerAction(p) { return getAfter(/databases/$(database)/documents/events/$(p.lastEvent)).data.kind; }
    function normalized(s) {
      return s.lower().replace('[àáâãäå]', 'a').replace('[èéêë]', 'e')
        .replace('[ìíîï]', 'i').replace('[òóôõö]', 'o').replace('[ùúûü]', 'u')
        .replace('ç', 'c').replace('ñ', 'n').replace('[ýÿ]', 'y')
        .replace('[̀-ͯ]', '').trim().replace('\\s+', ' ');
    }
    function validPlayer(id, p) {
      return p.keys().hasAll(['name','congregation','teams','updatedAt','lastEvent'])
        && p.keys().hasOnly(['name','congregation','teams','updatedAt','lastEvent','status'])
        && p.get('status','active') in ['active','inactive','deleted']
        && p.name is string && p.name.size() >= 3 && p.name.size() <= 120
        && p.congregation is string && p.congregation.size() >= 2 && p.congregation.size() <= 120
        && !p.name.matches('.*[|].*') && !p.congregation.matches('.*[|].*')
        && id == hashing.sha256(normalized(p.name) + '|' + normalized(p.congregation)).toHexString().lower()
        && p.teams is list && p.teams.size() >= 1 && p.teams.size() <= 2
        && p.teams.toSet().size() == p.teams.size()
        && teamCatalog().keys().hasAll(p.teams)
        && p.updatedAt == request.time && p.lastEvent is string;
    }
    function playerEvent(id, p, kind, from, to) {
      let e = getAfter(/databases/$(database)/documents/events/$(p.lastEvent)).data;
      let items = teamCatalog();
      return e.playerId == id && e.name == p.name && e.actor == request.auth.uid
        && e.at == request.time && e.kind == kind && e.from == from && e.to == to
        && e.detail == (kind == 'add' ? 'Inscrição em ' + items[to].name : items[from].name + ' → ' + items[to].name);
    }
    function addition(id, old, p) {
      let added = p.teams.removeAll(old.teams);
      return p.teams.size() == old.teams.size() + 1 && p.teams.toSet().hasAll(old.teams)
        && added.size() == 1 && manages(added[0]) && teamActive(added[0])
        && playerEvent(id, p, 'add', '', added[0]);
    }
    function transfer(id, old, p) {
      let removed = old.teams.removeAll(p.teams);
      let added = p.teams.removeAll(old.teams);
      return p.teams.size() == old.teams.size() && removed.size() == 1 && added.size() == 1
        && manages(removed[0]) && teamActive(added[0])
        && get(/databases/$(database)/documents/settings/transfers).data.open == true
        && playerEvent(id, p, 'transfer', removed[0], added[0]);
    }
    function validMerge(eventId) {
      let e = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      let source = get(/databases/$(database)/documents/players/$(e.sourceId)).data;
      let target = get(/databases/$(database)/documents/players/$(e.targetId)).data;
      let afterSource = getAfter(/databases/$(database)/documents/players/$(e.sourceId)).data;
      let afterTarget = getAfter(/databases/$(database)/documents/players/$(e.targetId)).data;
      return admin() && e.kind == 'merge' && e.actor == request.auth.uid && e.at == request.time
        && e.keys().hasOnly(['actor','actorName','at','kind','sourceId','targetId','name','sourceName','sourceCongregation','targetCongregation','sourceTeams','targetTeams','teams','detail'])
        && e.sourceId != e.targetId && active(source) && active(target)
        && e.name == target.name && e.sourceName == source.name
        && e.sourceCongregation == source.congregation && e.targetCongregation == target.congregation
        && e.sourceTeams == source.teams && e.targetTeams == target.teams
        && e.teams == afterTarget.teams && e.teams.toSet() == source.teams.toSet().union(target.teams.toSet())
        && validPlayer(e.targetId, afterTarget)
        && afterSource.diff(source).affectedKeys().hasOnly(['teams','mergedInto','updatedAt','lastEvent'])
        && afterTarget.diff(target).affectedKeys().hasOnly(['teams','updatedAt','lastEvent'])
        && afterSource.teams == [] && afterSource.mergedInto == e.targetId
        && afterSource.lastEvent == eventId && afterTarget.lastEvent == eventId
        && source.lastEvent != eventId && target.lastEvent != eventId
        && afterSource.updatedAt == request.time && afterTarget.updatedAt == request.time
        && e.detail is string && e.detail.size() <= 1000;
    }
    function validStatus(eventId) {
      let e = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      let old = get(/databases/$(database)/documents/players/$(e.playerId)).data;
      let p = getAfter(/databases/$(database)/documents/players/$(e.playerId)).data;
      return admin() && e.kind == 'status' && e.actor == request.auth.uid && e.at == request.time
        && e.keys().hasOnly(['actor','actorName','at','kind','playerId','name','previousStatus','status','detail','teams'])
        && e.get('teams',old.teams) == old.teams
        && !('mergedInto' in old) && validPlayer(e.playerId,p)
        && e.name == old.name && e.previousStatus == old.get('status','active')
        && e.status == p.status && e.status != e.previousStatus
        && p.diff(old).affectedKeys().hasOnly(['status','updatedAt','lastEvent'])
        && p.lastEvent == eventId && old.lastEvent != eventId
        && e.detail is string && e.detail.size() <= 1000;
    }
    function validEdit(eventId) {
      let e = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      let old = get(/databases/$(database)/documents/players/$(e.sourceId)).data;
      let p = getAfter(/databases/$(database)/documents/players/$(e.playerId)).data;
      let archived = getAfter(/databases/$(database)/documents/players/$(e.sourceId)).data;
      return admin() && e.kind == 'edit' && e.actor == request.auth.uid && e.at == request.time
        && e.keys().hasOnly(['actor','actorName','at','kind','sourceId','playerId','name','congregation','previousName','previousCongregation','detail','teams'])
        && e.get('teams',old.teams) == old.teams
        && !('mergedInto' in old) && old.get('status','active') != 'deleted'
        && validPlayer(e.playerId,p) && e.name == p.name && e.congregation == p.congregation
        && e.previousName == old.name && e.previousCongregation == old.congregation
        && p.diff(old).affectedKeys().hasOnly(['name','congregation','updatedAt','lastEvent'])
        && p.lastEvent == eventId && old.lastEvent != eventId
        && (e.sourceId == e.playerId || (!exists(/databases/$(database)/documents/players/$(e.playerId))
          && archived.diff(old).affectedKeys().hasOnly(['teams','mergedInto','updatedAt','lastEvent'])
          && archived.teams == [] && archived.mergedInto == e.playerId
          && archived.lastEvent == eventId && archived.updatedAt == request.time))
        && e.detail is string && e.detail.size() <= 1000;
    }
    function validTeamEvent(eventId) {
      let e = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      let old = teamCatalog();
      let catalog = getAfter(/databases/$(database)/documents/settings/teams).data;
      let next = catalog.items[e.teamId];
      return admin() && e.kind == 'team' && e.actor == request.auth.uid && e.at == request.time
        && e.keys().hasOnly(['actor','actorName','at','kind','action','teamId','previous','next','name','detail'])
        && e.teamId is string && e.teamId.size() > 0 && e.teamId.size() <= 100 && !e.teamId.matches('.*[/|].*')
        && !(e.teamId in ['__proto__','constructor','prototype'])
        && catalog.keys().hasOnly(['items','updatedAt','lastEvent']) && catalog.updatedAt == request.time && catalog.lastEvent == eventId
        && catalog.items.keys().hasAll(old.keys()) && catalog.items.diff(old).affectedKeys().hasOnly([e.teamId])
        && next.keys().hasAll(['name','badge','color','status']) && next.keys().hasOnly(['name','badge','color','status'])
        && next.name is string && next.name.size() >= 2 && next.name.size() <= 60 && !next.name.matches('.*[|].*')
        && next.badge is string && next.badge.size() >= 1 && next.badge.size() <= 12
        && next.color in ['white','black','blue','brown','olive','yellow','orange','green','red','purple']
        && next.status in ['active','inactive','deleted'] && e.next == next && e.name == next.name
        && e.previous == old.get(e.teamId,null)
        && ((e.action == 'createTeam' && !(e.teamId in old) && next.status == 'active')
          || (e.action == 'editTeam' && e.teamId in old && old[e.teamId].status != 'deleted' && next.status == old[e.teamId].status)
          || (e.action == 'setTeamStatus' && e.teamId in old && next.status != old[e.teamId].status
            && next.diff(old[e.teamId]).affectedKeys().hasOnly(['status'])))
        && e.detail is string && e.detail.size() <= 1000;
    }
    function validDuplicateReview(reviewId) {
      let r = getAfter(/databases/$(database)/documents/duplicateReviews/$(reviewId)).data;
      let source = get(/databases/$(database)/documents/players/$(r.sourceId)).data;
      let target = get(/databases/$(database)/documents/players/$(r.targetId)).data;
      let e = getAfter(/databases/$(database)/documents/events/$(r.lastEvent)).data;
      return admin() && r.keys().hasAll(['sourceId','targetId','sourceName','targetName','sourceCongregation','targetCongregation','different','actor','updatedAt','lastEvent'])
        && r.keys().hasOnly(['sourceId','targetId','sourceName','targetName','sourceCongregation','targetCongregation','different','actor','updatedAt','lastEvent'])
        && r.sourceId.matches('[a-f0-9]{64}') && r.targetId.matches('[a-f0-9]{64}') && r.sourceId < r.targetId
        && reviewId == r.sourceId + '_' + r.targetId && active(source) && active(target)
        && r.sourceName == source.name && r.targetName == target.name
        && r.sourceCongregation == source.congregation && r.targetCongregation == target.congregation
        && r.different is bool && r.actor == request.auth.uid && r.updatedAt == request.time
        && e.keys().hasOnly(['actor','actorName','at','kind','reviewId','name','different','detail','teams'])
        && (!('teams' in e) || (e.teams is list && e.teams.toSet() == source.teams.toSet().union(target.teams.toSet())))
        && e.kind == 'duplicateReview' && e.reviewId == reviewId && e.actor == request.auth.uid && e.at == request.time
        && e.name == source.name && e.different == r.different && e.detail is string && e.detail.size() <= 1000;
    }
    match /duplicateReviews/{id} {
      allow read: if admin();
      allow create, update: if admin() && validDuplicateReview(id);
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll(['role','team','displayName','email','createdAt'])
        && request.resource.data.keys().hasOnly(['role','team','displayName','email','createdAt'])
        && request.resource.data.role == 'pending' && request.resource.data.team == ''
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','displayName'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120;
      allow update: if admin() && request.auth.uid != uid && resource.data.role != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','team','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.role == 'pending' && request.resource.data.team == '')
          || (request.resource.data.role == 'director' && teamActive(request.resource.data.team)));
      allow delete: if false;
    }
    match /players/{id} {
      allow read: if member();
      allow create: if member() && playerAction(request.resource.data) == 'add' && validPlayer(id, request.resource.data)
        && active(request.resource.data)
        && request.resource.data.teams.size() == 1 && manages(request.resource.data.teams[0]) && teamActive(request.resource.data.teams[0])
        && playerEvent(id, request.resource.data, 'add', '', request.resource.data.teams[0]);
      allow create: if admin() && playerAction(request.resource.data) == 'edit' && validEdit(request.resource.data.lastEvent)
        && id == getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.playerId;
      allow update: if member() && playerAction(request.resource.data) in ['add','transfer'] && active(resource.data) && validPlayer(id, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams','updatedAt','lastEvent'])
        && request.resource.data.lastEvent != resource.data.lastEvent
        && (addition(id, resource.data, request.resource.data) || transfer(id, resource.data, request.resource.data));
      allow update: if admin() && playerAction(request.resource.data) == 'merge' && validMerge(request.resource.data.lastEvent)
        && (id == getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.sourceId
          || id == getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.targetId);
      allow update: if admin() && playerAction(request.resource.data) == 'status' && validStatus(request.resource.data.lastEvent)
        && id == getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.playerId;
      allow update: if admin() && playerAction(request.resource.data) == 'edit' && validEdit(request.resource.data.lastEvent)
        && (id == getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.playerId
          || id == getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.sourceId);
      allow delete: if false;
    }
    match /settings/transfers {
      allow read: if member();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['open','updatedAt','lastEvent'])
        && request.resource.data.open is bool && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.kind == 'window'
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.open == request.resource.data.open
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.actor == request.auth.uid
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.lastEvent)).data.at == request.time;
      allow delete: if false;
    }
    match /settings/teams {
      allow read: if member();
      allow create, update: if admin() && validTeamEvent(request.resource.data.lastEvent);
      allow delete: if false;
    }
    match /events/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.actor == request.auth.uid
        && (!('actorName' in request.resource.data) || request.resource.data.actorName == profile().get('displayName',profile().get('email','Diretor')))
        && request.resource.data.at == request.time && (
          (request.resource.data.kind == 'merge' && validMerge(id))
          || (request.resource.data.kind == 'duplicateReview' && validDuplicateReview(request.resource.data.reviewId)
            && getAfter(/databases/$(database)/documents/duplicateReviews/$(request.resource.data.reviewId)).data.lastEvent == id)
          || (request.resource.data.kind == 'team' && validTeamEvent(id))
          || (request.resource.data.kind == 'status' && validStatus(id))
          || (request.resource.data.kind == 'edit' && validEdit(id))
          ||
          (request.resource.data.kind in ['add','transfer']
            && request.resource.data.keys().hasOnly(['actor','actorName','at','kind','playerId','name','from','to','detail'])
            && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.lastEvent == id
            && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.updatedAt == request.time)
          || (request.resource.data.kind == 'window' && admin()
            && request.resource.data.keys().hasOnly(['actor','actorName','at','kind','open','name','detail'])
            && request.resource.data.name == 'Janela de transferências'
            && request.resource.data.detail == (request.resource.data.open ? 'Aberta pela administração' : 'Fechada pela administração')
            && getAfter(/databases/$(database)/documents/settings/transfers).data.lastEvent == id
            && getAfter(/databases/$(database)/documents/settings/transfers).data.updatedAt == request.time)
        );
      allow update, delete: if false;
    }
  }
}
